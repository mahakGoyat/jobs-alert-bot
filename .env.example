# Environment variables required to run this bot.
# Copy this file to .env and fill in your own real values.
# Never commit the actual .env file.

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Groq API key for AI content generation
GROQ_API_KEY=your_groq_api_key

# SerpAPI key for fetching job search results
SERPAPI_KEY=your_serpapi_key

# Supabase project credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Pixabay API key for images
PIXABAY_API_KEY=your_pixabay_api_key
